<!-- End turn keeps an outline so it stands apart from the gold move control. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/phone_button_outline_pressed" />
            <stroke android:width="1.5dp" android:color="@color/phone_button_outline" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/phone_panel" />
            <stroke android:width="1.5dp" android:color="@color/phone_button_outline" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
