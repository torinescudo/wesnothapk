<!-- Reserved for the one action that commits the turn: move / attack. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/phone_gold_pressed" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/phone_gold" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
