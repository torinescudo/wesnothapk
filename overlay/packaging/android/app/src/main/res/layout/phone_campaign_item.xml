<!-- One story in the campaign picker: a card sized for a thumb. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/phone_campaign_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/phone_sheet_item"
    android:minHeight="132dp"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/phone_campaign_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/phone_text"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/phone_campaign_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/phone_text_muted"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/phone_campaign_hook"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/phone_text_secondary"
        android:textSize="19sp" />
</LinearLayout>
