<!-- One story in the campaign picker: name, protagonist and length, and hook. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/phone_campaign_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/phone_sheet_item"
    android:minHeight="72dp"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/phone_campaign_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/phone_text"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/phone_campaign_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/phone_text_muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/phone_campaign_hook"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/phone_text_secondary"
        android:textSize="14sp" />
</LinearLayout>
