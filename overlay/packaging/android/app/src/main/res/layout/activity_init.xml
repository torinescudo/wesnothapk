<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-2.0-or-later -->
<!-- Launcher: single column, thumb-sized. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/phone_background">

    <ImageButton
        android:id="@+id/settings_btn"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/phone_icon_button"
        android:contentDescription="@string/phone_settings"
        android:padding="16dp"
        android:scaleType="centerInside"
        android:src="@drawable/settings" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="28dp">

            <ImageView
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:src="@drawable/wesnoth_icon"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/app_name"
                android:textColor="@color/phone_text"
                android:textSize="34sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/phone_welcome"
                android:textColor="@color/phone_text_secondary"
                android:textSize="20sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/app_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/phone_text_muted"
                android:textSize="16sp"
                android:gravity="center" />

            <Button
                android:id="@+id/tap_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:minHeight="88dp"
                android:background="@drawable/phone_button_primary"
                android:text="@string/phone_play"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="26sp"
                android:textColor="@color/phone_ink" />

            <Button
                android:id="@+id/phone_campaigns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:minHeight="88dp"
                android:background="@drawable/phone_button"
                android:text="@string/phone_campaigns"
                android:textAllCaps="false"
                android:textSize="24sp"
                android:textColor="@color/phone_text" />

            <Button
                android:id="@+id/phone_tutorial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:minHeight="88dp"
                android:background="@drawable/phone_button"
                android:text="@string/phone_tutorial"
                android:textAllCaps="false"
                android:textSize="24sp"
                android:textColor="@color/phone_text" />

            <TextView
                android:id="@+id/download_msg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textColor="@color/phone_text"
                android:textSize="18sp"
                android:gravity="center" />

            <ProgressBar
                android:id="@+id/download_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progressTint="@color/phone_gold"
                android:progressBackgroundTint="#33FFFFFF" />

            <TextView
                android:id="@+id/phone_first_launch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/phone_first_launch"
                android:textColor="@color/phone_text_muted"
                android:textSize="16sp"
                android:gravity="center" />

            <View android:id="@+id/phone_campaign_title" android:layout_width="0dp" android:layout_height="0dp" />
            <View android:id="@+id/phone_campaign_meta" android:layout_width="0dp" android:layout_height="0dp" />
            <View android:id="@+id/phone_campaign_hook" android:layout_width="0dp" android:layout_height="0dp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:id="@+id/phone_bar" android:layout_width="0dp" android:layout_height="0dp" android:orientation="vertical">
        <LinearLayout android:id="@+id/phone_bar_actions" android:layout_width="0dp" android:layout_height="0dp" android:orientation="horizontal">
            <View android:id="@+id/phone_bar_toggle" android:layout_width="0dp" android:layout_height="0dp" />
            <View android:id="@+id/phone_action_cycle" android:layout_width="0dp" android:layout_height="0dp" />
            <View android:id="@+id/phone_action_recruit" android:layout_width="0dp" android:layout_height="0dp" />
            <View android:id="@+id/phone_action_undo" android:layout_width="0dp" android:layout_height="0dp" />
            <View android:id="@+id/phone_action_endturn" android:layout_width="0dp" android:layout_height="0dp" />
            <View android:id="@+id/phone_action_zoomin" android:layout_width="0dp" android:layout_height="0dp" />
            <View android:id="@+id/phone_action_zoomout" android:layout_width="0dp" android:layout_height="0dp" />
            <View android:id="@+id/phone_action_objectives" android:layout_width="0dp" android:layout_height="0dp" />
            <View android:id="@+id/phone_action_save" android:layout_width="0dp" android:layout_height="0dp" />
            <View android:id="@+id/phone_action_recall" android:layout_width="0dp" android:layout_height="0dp" />
            <View android:id="@+id/phone_action_unitlist" android:layout_width="0dp" android:layout_height="0dp" />
            <View android:id="@+id/phone_action_leader" android:layout_width="0dp" android:layout_height="0dp" />
            <View android:id="@+id/phone_action_describeunit" android:layout_width="0dp" android:layout_height="0dp" />
            <View android:id="@+id/phone_action_preferences" android:layout_width="0dp" android:layout_height="0dp" />
            <View android:id="@+id/phone_action_quit" android:layout_width="0dp" android:layout_height="0dp" />
            <View android:id="@+id/phone_action_moveaction" android:layout_width="0dp" android:layout_height="0dp" />
            <View android:id="@+id/phone_action_more" android:layout_width="0dp" android:layout_height="0dp" />
            <View android:id="@+id/phone_action_help" android:layout_width="0dp" android:layout_height="0dp" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
