<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="@drawable/phone_background">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:padding="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:paddingEnd="24dp">
                <ImageView android:layout_width="88dp" android:layout_height="88dp"
                    android:src="@drawable/wesnoth_icon" android:importantForAccessibility="no" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="@string/app_name"
                    android:textColor="#F7EBD1" android:textSize="30sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="@string/phone_welcome"
                    android:textColor="#CAD7D9" android:textSize="16sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:paddingTop="32dp">
                <Button android:id="@+id/tap_label" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="56dp"
                    android:background="@drawable/phone_primary_button" android:text="@string/phone_play"
                    android:textAllCaps="false" android:textStyle="bold" android:textSize="20sp"
                    android:textColor="#162731" />
                <Button android:id="@+id/phone_tutorial" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:minHeight="52dp" android:text="@string/phone_tutorial"
                    android:textAllCaps="false" android:textSize="18sp" android:textColor="#F7EBD1" />
                <Button android:id="@+id/phone_campaigns" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:minHeight="52dp" android:text="@string/phone_campaigns"
                    android:textAllCaps="false" android:textSize="18sp" android:textColor="#F7EBD1" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="@string/phone_first_launch"
                    android:textColor="#CAD7D9" android:textSize="14sp" />
                <TextView android:id="@+id/download_msg" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:textColor="#F7EBD1" android:textSize="16sp" />
                <ProgressBar android:id="@+id/download_progress"
                    style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:progressTint="#E0C080" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <ImageButton android:id="@+id/settings_btn" android:layout_width="56dp"
        android:layout_height="56dp" android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true" android:background="@android:color/transparent"
        android:padding="16dp" android:contentDescription="@string/phone_settings"
        android:src="@drawable/settings" />
</RelativeLayout>
